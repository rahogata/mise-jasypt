#!/usr/bin/env sh
#MISE description="Run plugin tests - install and test all Jasypt commands"
set -eu

jasypt_version="1.9.3"
plugin_dir="$(pwd -P)"

# Isolate mise configuration, plugins, and cache.
test_dir="$(mktemp -d)"
trap 'rm -rf "$test_dir"' EXIT
trap 'exit 1' HUP INT TERM

export MISE_CONFIG_DIR="$test_dir/config"
export MISE_SYSTEM_CONFIG_DIR="$test_dir/system"
export MISE_GLOBAL_CONFIG_FILE="$test_dir/global.toml"
export MISE_DATA_DIR="$test_dir/data"
export MISE_CACHE_DIR="$test_dir/cache"
export MISE_STATE_DIR="$test_dir/state"
export MISE_ENV_CACHE=0
export MISE_YES=1

mkdir -p "$test_dir/project"
cd "$test_dir/project"

# Generate a fresh random password without OpenSSL.
test_password="$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')"

if [ -z "$test_password" ]; then
    echo "✗ Failed to generate test password" >&2
    exit 1
fi

# Link the working tree only inside this temporary mise environment.
mise plugin link jasypt "$plugin_dir"

# 1. Assert supported version discovery.
versions="$(mise ls-remote --minimum-release-age 0s jasypt)"

if ! printf '%s\n' "$versions" | grep -Fxq "$jasypt_version"; then
    echo "✗ Supported versions: expected $jasypt_version in version list" >&2
    exit 1
fi
echo "✓ Supported versions"

# 2. Install the fixed version.
mise install "jasypt@$jasypt_version"

install_dir="$(mise where "jasypt@$jasypt_version")"

# 3. Determine the expected platform-specific command extension.
case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*)
        script_ext="bat"
        platform="Windows"
        ;;
    *)
        script_ext="sh"
        platform="Unix"
        ;;
esac

script_dir="$install_dir/bin"

# Verify that mise installed the commands into the expected bin directory.
if [ ! -d "$script_dir" ]; then
    echo "✗ $platform: expected bin directory: $script_dir" >&2
    echo "Installation directory contents:" >&2
    find "$install_dir" -maxdepth 3 -type f >&2
    exit 1
fi

for command_name in encrypt decrypt digest listAlgorithms; do
    executable="jasypt_${command_name}.${script_ext}"
    expected_path="$script_dir/$executable"

    if [ ! -f "$expected_path" ]; then
        echo "✗ $platform: command missing from expected bin directory: $executable" >&2
        echo "Expected: $expected_path" >&2
        echo "Installed files:" >&2
        find "$install_dir" -maxdepth 3 -type f >&2
        exit 1
    fi
done

echo "✓ $platform: command files exist in bin"

# Execute commands through mise so its environment and PATH are applied.
run_jasypt() {
    command_name=$1
    shift

    executable="jasypt_${command_name}.${script_ext}"

    mise exec "jasypt@$jasypt_version" -- "$executable" "$@"
}

assert_contains() {
    description=$1
    actual=$2
    expected=$3

    case "$actual" in
        *"$expected"*)
            echo "✓ $description"
            ;;
        *)
            echo "✗ $description: expected output to contain '$expected'" >&2
            echo "Actual output: $actual" >&2
            exit 1
            ;;
    esac
}

assert_fails() {
    description=$1
    shift

    if "$@" >"$test_dir/negative.stdout" 2>"$test_dir/negative.stderr"; then
        echo "✗ $description: command unexpectedly succeeded" >&2
        echo "Stdout: $(cat "$test_dir/negative.stdout")" >&2
        echo "Stderr: $(cat "$test_dir/negative.stderr")" >&2
        exit 1
    fi

    echo "✓ $description"
}

assert_output_contains() {
    name=$1
    expected=$2
    shift 2

    if output=$(run_jasypt "$@" 2>&1); then
        :
    else
        :
    fi

    if printf '%s\n' "$output" | grep -Fq -- "$expected"; then
        printf '✓ %s\n' "$name"
    else
        printf '✗ %s\n' "$name"
        printf '%s\n' "$output"
        exit 1
    fi
}

# Extract the last non-empty line from the OUTPUT section.
extract_output() {
    printf '%s\n' "$1" |
        sed -n '/----OUTPUT/,$p' |
        tail -n +2 |
        tr -d '\r' |
        sed '/^[[:space:]]*$/d' |
        tail -n 1
}

# 4. Encrypt.
plaintext="mise-plugin-test"

output="$(run_jasypt encrypt \
    "input=$plaintext" \
    "password=$test_password")"

encrypted="$(extract_output "$output")"

if [ -z "$encrypted" ]; then
    echo "✗ Encrypt: could not extract ciphertext" >&2
    echo "Actual output: $output" >&2
    exit 1
fi
echo "✓ Encrypt"

# 5. Decrypt using the same random password.
output="$(run_jasypt decrypt \
    "input=$encrypted" \
    "password=$test_password")"

decrypted="$(extract_output "$output")"
assert_contains "Decrypt" "$decrypted" "$plaintext"

# Encrypt and decrypt plaintext containing special characters.
special_plaintext='Hello, World! $HOME "quoted" '\''single'\'' & <tag> (test)'

output="$(run_jasypt encrypt \
    "input=$special_plaintext" \
    "password=$test_password")"

special_encrypted="$(extract_output "$output")"

if [ -z "$special_encrypted" ]; then
    echo "✗ Special characters: encryption returned empty output" >&2
    exit 1
fi

output="$(run_jasypt decrypt \
    "input=$special_encrypted" \
    "password=$test_password")"

special_decrypted="$(extract_output "$output")"

if [ "$special_decrypted" != "$special_plaintext" ]; then
    echo "✗ Special characters: decrypted text does not match" >&2
    printf 'Expected: <%s>\nActual:   <%s>\n' \
        "$special_plaintext" "$special_decrypted" >&2
    exit 1
fi

echo "✓ Special characters preserved through encryption and decryption"

# 6. Digest.
output="$(run_jasypt digest "input=$plaintext")"

digest="$(extract_output "$output")"

if [ -z "$digest" ]; then
    echo "✗ Digest: empty output" >&2
    echo "Actual output: $output" >&2
    exit 1
fi
echo "✓ Digest"

# 7. List algorithms.
output="$(run_jasypt listAlgorithms)"
assert_contains "List algorithms" "$output" "PBE"

echo "✓ All Jasypt plugin tests passed"

# 8. Negative scenarios.

# Encrypt without required arguments.
assert_fails "Encrypt rejects missing input" \
    run_jasypt encrypt "password=$test_password"

assert_fails "Encrypt rejects missing password" \
    run_jasypt encrypt "input=$plaintext"

# Decrypt without required arguments.
assert_fails "Decrypt rejects missing input" \
    run_jasypt decrypt "password=$test_password"

assert_fails "Decrypt rejects missing password" \
    run_jasypt decrypt "input=$encrypted"

# Decrypt with an incorrect password.
assert_output_contains \
    "Decrypt rejects incorrect password" \
    "Operation not possible" \
    decrypt \
        "input=$encrypted" \
        "password=definitely-not-the-correct-password"

# Decrypt malformed ciphertext.
assert_output_contains \
    "Decrypt rejects malformed ciphertext" \
    "Operation not possible" \
    decrypt \
        "input=not-a-valid-ciphertext" \
        "password=$test_password"

# Digest without the required input.
assert_fails "Digest rejects missing input" \
    run_jasypt digest

# Reject an unsupported version.
if mise install "jasypt@999.999.999" >"$test_dir/wrong-version.stdout" 2>"$test_dir/wrong-version.stderr"; then
    echo "✗ Unsupported version should fail" >&2
    exit 1
else
    echo "✓ Unsupported version rejected"
fi

echo "✓ All Jasypt plugin tests passed"
