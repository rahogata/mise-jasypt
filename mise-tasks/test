#!/usr/bin/env sh
#MISE description="Run plugin tests - install and execute tool"
set -eu

jasypt_version="1.9.3"

mise plugin link --force jasypt .
mise cache clear
mise ls-remote --minimum-release-age 0s jasypt
mise install "jasypt@$jasypt_version"

output=$(mise exec "jasypt@$jasypt_version" -- jasypt --version)
echo "jasypt output: $output"

case "$output" in
    *"jasypt@$jasypt_version"*)
        echo "✓ Tests passed"
        ;;
    *)
        echo "✗ Test failed: expected version jasypt@$jasypt_version" >&2
        exit 1
        ;;
esac
