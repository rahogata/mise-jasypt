#!/usr/bin/env bash
#MISE description="Run plugin tests - install and execute tool"
set -euo pipefail

mise plugin link --force jasypt .
mise cache clear jasypt
mise ls-remote jasypt
mise install jasypt@1.9.3

# Capture and display the output while also verifying it
output=$(mise exec "jasypt@1.9.3" -- "jasypt" --version)
echo "jasypt output: $output"

if echo "$output" | grep -q 'jasypt@1.0.0'; then
    echo "✓ Tests passed"
else
    echo "✗ Test failed: expected version jasypt@1.0.0"
    exit 1
fi
